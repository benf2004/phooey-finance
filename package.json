{
  "name": "phooey-finance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-source.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm test",
    "db:migrate": "wrangler d1 migrations apply phooey-finance --local",
    "setup:local": "node scripts/setup-local.mjs",
    "cf:types": "wrangler types",
    "deploy": "CLOUDFLARE_ENV=production npm run build && wrangler deploy",
    "seed:demo": "node scripts/seed-demo.mjs",
    "db:migrate:production": "wrangler d1 migrations apply phooey-finance --remote --env production"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "agents": "^0.33.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.6.1",
    "hono": "^4.13.18",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "miniflare": "^5.20261110.0-beta",
    "node": "^24.22.3",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
